cat > .gitignore <<'EOF'
# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.utmp/

# IDE and editor
.vs/
.idea/
.vscode/
.gradle/
.consulo/

# Generated Visual Studio files
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Build and package files
*.apk
*.aab

# Exported files
ExportedObj/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Crash reports
sysinfo.txt
EOF